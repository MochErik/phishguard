{
  "version": 2,
  "framework": null,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "preview/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/health",
      "dest": "api/index.py"
    },
    {
      "src": "/assets/(.*)",
      "dest": "preview/assets/$1"
    },
    {
      "src": "/manifest.webmanifest",
      "dest": "preview/manifest.webmanifest"
    },
    {
      "src": "/(.*)",
      "dest": "preview/index.html"
    }
  ]
}
